# Local-development environment for go-oikumenea TOOLING.
#
# Copy to `.env` (gitignored) and tweak for your machine:  cp .env.example .env
#
# This file feeds the out-of-process tooling:
#   - Atlas        (`atlas migrate apply --env local` reads $DATABASE_URL — see atlas.hcl)
#   - docker compose (`docker-compose.dev.yml` interpolates $OIKU_DB_HOST_PORT)
#   - integration tests (`go test -tags integration` reads $OIKUMENEA_TEST_DSN)
#   - the Makefile (targets export these to their sub-commands)
#
# The SERVER also auto-loads .env at boot (D-EnvConfig) — but it only consumes OIKUMENEA_* / HERMENEA_*
# variables (env overrides var/conf/install.yml; a real env var wins over .env). The DATABASE_URL /
# OIKUMENEA_TEST_DSN / OIKU_* entries below are for the tooling and are ignored by the server. To
# configure the server itself from here, add OIKUMENEA_* keys (e.g. OIKUMENEA_DB_HOST, OIKUMENEA_DB_USER;
# see docs/reference/env-vars.md).
#
# RLS roles (D-RLSDefenseInDepth, migration 0012): MIGRATIONS + integration TESTS run as the
# owner/superuser `postgres` (migrations must run as the owner; the tests call the application
# services directly, bypassing the request middleware that pins per-request RLS GUCs, so they use the
# bypassing superuser). The SERVER (var/conf/install.yml) connects as the NON-superuser `oikumenea`
# role so the backstop is in force at runtime. Create that login role once, after applying migrations:
#   CREATE ROLE oikumenea LOGIN PASSWORD 'dev' IN ROLE oikumenea_app;
#
# Dev DB vs TEST DB: the integration tests run against a DEDICATED database (oikumenea_test) so they
# never pollute the dev/operator DB the running server + web console read — keep DATABASE_URL and
# OIKUMENEA_TEST_DSN on DIFFERENT databases. Create + migrate the test DB once with
# ./scripts/setup-test-db.sh (idempotent; --reset to rebuild it).

# Host port the docker-compose.dev.yml Postgres publishes. Change if 5432 is taken locally
# (then update the DSNs below to match).
OIKU_DB_HOST_PORT=5432

# Operator DB connection Atlas applies migrations to (env "local" in atlas.hcl).
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres?sslmode=disable

# DSN the //go:build integration tests connect to (internal/<module>/*_integration_test.go). A
# DEDICATED database, separate from DATABASE_URL above (see ./scripts/setup-test-db.sh).
OIKUMENEA_TEST_DSN=postgres://postgres:dev@localhost:5432/oikumenea_test?sslmode=disable

# The hermenea companion (M16 / D-Hermenea) owns its OWN database, separate from oikumenea's. Atlas
# applies migrations/hermenea to it (env "hermenea" in atlas.hcl reads $HERMENEA_DATABASE_URL); its
# integration tests use a dedicated hermenea_test DB ($HERMENEA_TEST_DSN; ./scripts/setup-test-db.sh
# provisions it). Both default to a `hermenea`/`hermenea_test` DB on the same local Postgres.
HERMENEA_DATABASE_URL=postgres://postgres:dev@localhost:5432/hermenea?sslmode=disable
HERMENEA_TEST_DSN=postgres://postgres:dev@localhost:5432/hermenea_test?sslmode=disable

# The two hermenea shared secrets (D-Hermenea) — RUNTIME env vars read by cmd/oikumenea + cmd/hermenea
# (NOT install config). HERMENEA_OIKUMENEA_TOKEN authorizes hermenea's import calls into oikumenea (the
# `hermenea-importer` principal); OIKUMENEA_HERMENEA_TOKEN authenticates push triggers to hermenea's
# /sync. The SAME HERMENEA_OIKUMENEA_TOKEN must be set on BOTH processes. INSECURE local defaults.
HERMENEA_OIKUMENEA_TOKEN=local-dev-importer-secret
OIKUMENEA_HERMENEA_TOKEN=local-dev-trigger-secret

# Deployment-environment RID segment; must match var/conf/install.yml `environment`
# (it is baked into every RID via the app.environment GUC — D-ResourceIdentifiers).
OIKU_ENVIRONMENT=local

# Host port the docker-compose.dev.yml Keycloak publishes (the local OIDC IdP for manual auth testing,
# deploy/keycloak/). Must stay 8080 unless you also change the issuer URL in var/conf/install.yml
# (idp.issuers + bootstrap-admin) to match — the token `iss` must equal the configured issuer.
OIKU_KEYCLOAK_HOST_PORT=8080
