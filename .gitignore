# gödel build output
/out/

# local editor / OS noise
*.swp
.DS_Store

# local-dev tooling connection/secrets (commit .env.example instead)
.env
.env.local
.env.*.local
# brokered-provider client secrets (Example A); commit deploy/oauth/.env.oauth.example instead
.env.oauth

# OAuth client credentials for the local multi-IdP examples (D-MultiIdPExamples). These files carry a
# live client_secret — the downloaded Google/Entra/Okta client JSON, and any per-provider secret env
# file. Commit the *.example spellings instead; never the real ones.
/var/*.json
/var/oauth/
!/var/conf/

# compiled binaries dropped at the repo root by `go build ./cmd/oikumenea|./cmd/hermenea`.
# MUST be anchored with a leading slash — a bare `oikumenea`/`hermenea` matches every same-named
# directory in the tree (internal/hermenea, cmd/hermenea, migrations/hermenea, internal/conjure/oikumenea…)
# and silently ignores real source.
/oikumenea
/hermenea
/gen