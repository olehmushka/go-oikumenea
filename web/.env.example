# go-oikumenea web admin console — environment (D-WebUI).
# Copy to .env.local for `npm run dev`. All values below are LOCAL-DEV defaults.

# --- The go-oikumenea API (server-to-server target of the BFF proxy) ---
# REQUIRED — there is no default; console-bff throws at startup if this is unset (M52 /
# D-HeadlessTopology). Host dev (the binary run directly) is https://localhost:8443; in the packaged
# compose topology oikumenea publishes no host port and this is the internal https://app:8443.
API_BASE_URL="https://localhost:8443"
# The dev API serves a self-signed cert (witchcraft WithSelfSignedCertificate).
# DEV ONLY: let the Next.js server trust it. Do NOT set this in production.
NODE_TLS_REJECT_UNAUTHORIZED="0"

# --- Auth.js (NextAuth v5) ---
# Generate with:  openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-please-0000000000000000000="
# The public origin the browser uses to reach this app.
AUTH_URL="http://localhost:8445"
# Trust the forwarded host/port (needed behind the 8445 mapping).
AUTH_TRUST_HOST="true"

# --- Identity providers (D-MultiIdPExamples) ---
# The console offers a login button for EVERY provider whose credentials are set below, so enabling
# one is an env change, not a code edit. Two rules apply to each (see src/lib/auth/providers.ts):
#   * every issuer here must also appear in the service's `idp.issuers[]` (var/conf/install.yml),
#     spelled IDENTICALLY — the string is both the routing key and half the identity;
#   * the service must pin that issuer's `audience` to the client id below, or it would accept tokens
#     minted for unrelated applications. The service refuses to boot otherwise.
# Put real secrets in .env.local (gitignored), never here.

# Keycloak (the oikumenea-web confidential client) — the default, and the BROKER in Example A:
# Google/GitHub/... federate into this realm, so they need no entry of their own below.
AUTH_KEYCLOAK_ID="oikumenea-web"
AUTH_KEYCLOAK_SECRET="dev-oikumenea-web-secret"
# Must match the token `iss` exactly and be reachable from BOTH browser and this server.
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/oikumenea"

# Google (Example B — a direct second issuer alongside Keycloak).
# Register at console.cloud.google.com; redirect URI http://localhost:8445/api/auth/callback/google
# install.yml needs:  issuer https://accounts.google.com, audience = this client id.
# AUTH_GOOGLE_ID="<id>.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="..."

# Microsoft Entra ID. The issuer is tenant-scoped and MUST end in /v2.0.
# Redirect URI http://localhost:8445/api/auth/callback/entra
# AUTH_ENTRA_ID="..."
# AUTH_ENTRA_SECRET="..."
# AUTH_ENTRA_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# GitLab (issuer defaults to https://gitlab.com; set it for a self-managed instance).
# Redirect URI http://localhost:8445/api/auth/callback/gitlab ; scopes openid email profile
# AUTH_GITLAB_ID="..."
# AUTH_GITLAB_SECRET="..."
# AUTH_GITLAB_ISSUER="https://gitlab.com"

# Okta (or an Auth0-shaped tenant). Redirect URI http://localhost:8445/api/auth/callback/okta
# AUTH_OKTA_ID="..."
# AUTH_OKTA_SECRET="..."
# AUTH_OKTA_ISSUER="https://<tenant>.okta.com"

# ANY OTHER OIDC PROVIDER — no code change needed. <NAME> is yours to choose; it becomes the provider
# id (lowercased) and therefore the callback path /api/auth/callback/<name>. Endpoints are resolved
# from the issuer's discovery document.
# AUTH_OIDC_AUTHENTIK_ISSUER="https://id.example.org/application/o/oikumenea/"
# AUTH_OIDC_AUTHENTIK_ID="..."
# AUTH_OIDC_AUTHENTIK_SECRET="..."
# AUTH_OIDC_AUTHENTIK_LABEL="Authentik"     # optional button text

# NOT LISTED: GitHub. It is OAuth2 without OIDC — no ID token, no JWKS — so there is no token the
# service could verify. GitHub logins arrive brokered through Keycloak (Example A); see
# deploy/oauth/README.md.
